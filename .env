# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> blockk/bloques ###
# Sistema de bloques: lika (bloques Lika de 50 × 25 cm, por defecto) o generico (módulo de 62,5 × 25 cm).
BLOCK_SYSTEM=lika
###< blockk/bloques ###

###> blockk/assistant ###
# Asistente de diseño por chat (Kimi, API compatible con OpenAI). Sin clave ni modelo el chat queda deshabilitado.
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Modelo liviano y más barato (misma clave y endpoint): conversa, pregunta y decide cuándo delegar al de KIMI_MODEL,
# que arma el JSON final y las acciones directas. Vacío: todo lo hace KIMI_MODEL.
KIMI_MODEL_LIGHT=
# Modelo que lee imágenes, para calcar un plano adjunto. Vacío: lo hace KIMI_MODEL (tiene que aceptar imágenes).
KIMI_MODEL_VISION=
# Persistencia de conversaciones y diseños. Vacío: archivos en var/assistant (sólo para desarrollo).
REDIS_URL=
REDIS_PREFIX=blockk:
# Mensajes al asistente por día (todas las personas juntas) y por hora por IP.
ASSISTANT_DAILY_LIMIT=500
ASSISTANT_HOURLY_LIMIT=60
###< blockk/assistant ###

###> blockk/admin-api ###
# Token de la API de administracion (/api/admin/*): crear casas desde fuera del navegador. Vacio: la API no existe.
ADMIN_API_TOKEN=
###< blockk/admin-api ###
