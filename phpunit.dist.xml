<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="BLOCK_SYSTEM" value="lika" force="true" />
        <!-- los tests nunca usan credenciales reales del entorno: Kimi se simula con KimiMock -->
        <server name="KIMI_API_KEY" value="test-key" force="true" />
        <server name="KIMI_MODEL" value="kimi-test" force="true" />
        <server name="KIMI_BASE_URL" value="https://kimi.test/v1" force="true" />
        <server name="KIMI_MODEL_LIGHT" value="" force="true" />
        <server name="KIMI_MODEL_VISION" value="" force="true" />
        <server name="ADMIN_API_TOKEN" value="token-de-prueba" force="true" />
        <server name="REDIS_URL" value="" force="true" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
    </extensions>
</phpunit>
