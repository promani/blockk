{% extends 'base.html.twig' %}
{% set entry = 'styles' %}
{% block title %}Estilos{% endblock %}
{% block body %}
<script type="application/json" id="blockk-config">{{ config|raw }}</script>
<main class="page styles-page">
    <header class="page-head">
        <h1>Estilos del sitio</h1>
        <p class="lead">Elegí una paleta o cambiá cada color: se ve al instante en la vista previa y en todas las pantallas. Se guarda en este navegador.</p>
    </header>
    <div class="styles-grid">
        <section class="card styles-form" aria-labelledby="h-paletas">
            <h2 id="h-paletas">Paletas</h2>
            <div class="preset-list" id="presets" role="group" aria-label="Paletas"></div>
            <div id="fields"></div>
            <h3>Pisos de los ambientes</h3>
            <div class="floor-list" id="floors"></div>
            <div class="styles-actions">
                <button type="button" class="btn btn-outline" id="reset">Restablecer</button>
                <button type="button" class="btn btn-outline" id="copy" title="Copia la configuración para compartirla">Copiar configuración</button>
            </div>
            <p class="small muted" id="copy-out" role="status" aria-live="polite"></p>
        </section>
        <section class="styles-preview" aria-labelledby="h-vista">
            <h2 id="h-vista">Vista previa</h2>
            <div class="preview-canvas card">
                <canvas id="prev-iso" width="640" height="400" aria-label="Casa en isométrica con los colores elegidos"></canvas>
                <canvas id="prev-plan" width="640" height="400" aria-label="Planta con los colores elegidos"></canvas>
            </div>
            <div class="card preview-ui">
                <div class="levels" role="tablist"><button type="button" role="tab" class="level-tab" aria-selected="true">Nivel 1</button><button type="button" role="tab" class="level-tab" aria-selected="false">Techo</button></div>
                <p>Así se ven los botones, las etiquetas y los paneles.</p>
                <p><button type="button" class="btn btn-primary">Usar</button> <button type="button" class="btn btn-outline">✦ Modificar con IA</button></p>
                <ul class="taglist"><li>1 planta</li><li>Bajo descarte</li></ul>
                <div class="callout"><b>Revisión:</b> sin observaciones.</div>
            </div>
        </section>
    </div>
</main>
{% endblock %}
